<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>htmx todos</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js"></script>
  <script>
    // htmx ignores non-2xx responses by default, which would turn every
    // designed error into a dead click. 422, 410 and 404 are real UI here.
    htmx.config.responseHandling = [
      { code: "204", swap: false },
      { code: "[23]..", swap: true },
      { code: "422", swap: true },
      { code: "410", swap: true },
      { code: "404", swap: true },
      { code: "[45]..", swap: false, error: true },
    ];
  </script>
</head>
<body>
  <main>{% block content %}{% endblock %}</main>
</body>
</html>
